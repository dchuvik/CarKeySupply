---
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import Input from '@components/ui/atoms/Input.astro';
import Textarea from '@components/ui/atoms/Textarea.astro';
import Label from '@components/ui/atoms/Label.astro';
import Button from '@components/ui/atoms/Button.astro';
import company from '@data/global/company.json';
import appointments from '@data/global/appointments.json';
import { getNovaNavigationPath, type NovaLocale } from '@utils/nova-i18n';
import { buildSmsUrl, getAppointmentToday, normalizeSmsNumber } from '@utils/appointment-request';
import { getVehicleYears, vehicleMakes } from '@utils/vehicle-options';

interface Props { locale?: NovaLocale; id: string; }
const { locale = 'en', id } = Astro.props;
const copy = appointments[locale];
const flow = copy.funnel;
const fieldId = (name: string) => `${id}-${name}`;
const phoneHref = `tel:${normalizeSmsNumber(company.phone)}`;
const smsHref = buildSmsUrl(company.phone, flow.urgentMessage);
const withPhone = (text: string) => text.replace('{phone}', company.phone);
const vehicle = copy.vehicleSelect;
---

<div id={id} class="key-funnel" data-key-funnel data-locale={locale} data-phone={company.phone}>
  <div data-funnel-progress hidden>
    <Text tag="p" variant="accent-label" data-funnel-counter class="mb-3 text-brand-dark/65" aria-live="polite" />
    <ol class="funnel-progress" aria-label={copy.title}>
      {flow.steps.map((step, index) => <li data-progress-step={index + 1}><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span> {step}</li>)}
    </ol>
  </div>

  <form data-funnel-form novalidate>
    <section data-funnel-step="0" aria-labelledby={fieldId('urgency-title')}>
      <Heading id={fieldId('urgency-title')} tag="h2" class="funnel-title" tabindex="-1">{flow.urgencyTitle}</Heading>
      <Text class="funnel-description">{flow.urgencyDescription}</Text>
      <div class="funnel-choices">
        <button type="button" class="funnel-choice funnel-choice-urgent" data-funnel-go="urgent">
          <span class="funnel-choice-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m13 2-9 12h7l-1 8 10-13h-7l1-7Z" /></svg></span>
          <span><strong>{flow.urgentLabel}</strong><span class="funnel-choice-detail">{flow.urgentDetail}</span></span>
          <span class="funnel-choice-arrow" aria-hidden="true">↗</span>
        </button>
        <button type="button" class="funnel-choice" data-funnel-go="1">
          <span class="funnel-choice-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8" cy="8" r="5" /><path d="m11.5 11.5 9 9M17 17l3-3M14 14l3-3" /></svg></span>
          <span><strong>{flow.routineLabel}</strong><span class="funnel-choice-detail">{flow.routineDetail}</span></span>
          <span class="funnel-choice-arrow" aria-hidden="true">→</span>
        </button>
      </div>
      <Text variant="feature-body-sm" class="mt-5 text-brand-dark/65">{flow.appointmentOnly} · Elbridge, NY</Text>
    </section>

    <section data-funnel-step="urgent" hidden aria-labelledby={fieldId('urgent-title')}>
      <Heading id={fieldId('urgent-title')} tag="h2" class="funnel-title" tabindex="-1">{flow.urgentTitle}</Heading>
      <Text class="funnel-description">{flow.urgentDescription}</Text>
      <a class="funnel-phone" href={phoneHref}>{company.phone}</a>
      <div class="funnel-actions">
        <Button href={phoneHref} size="lg" variant="primary">{flow.call}</Button>
        <Button href={smsHref} size="lg" variant="outline" data-urgent-sms>{flow.text}</Button>
      </div>
      <Text variant="feature-body-sm" class="my-5 text-brand-dark/65">{flow.availability}</Text>
      <button type="button" class="funnel-text-button" data-funnel-go="1">{flow.routineInstead} →</button>
      <button type="button" class="funnel-text-button mt-3" data-funnel-go="0">← {flow.changeAnswer}</button>
    </section>

    <section data-funnel-step="1" hidden aria-labelledby={fieldId('vehicle-title')}>
      <Heading id={fieldId('vehicle-title')} tag="h2" class="funnel-title" tabindex="-1">{flow.vehicleTitle}</Heading>
      <Text class="funnel-description">{flow.vehicleDescription}</Text>
      <div class="funnel-fields">
        <div>
          <Label for={fieldId('year')}>{copy.labels.vehicleYear} *</Label>
          <select id={fieldId('year')} name="vehicleYear" class="ui-form-input" required>
            <option value="">{vehicle.year}</option>
            {getVehicleYears().map((year) => <option value={year}>{year}</option>)}
          </select>
        </div>
        <div>
          <Label for={fieldId('make')}>{copy.labels.vehicleMake} *</Label>
          <select id={fieldId('make')} name="vehicleMake" class="ui-form-input" required>
            <option value="">{vehicle.make}</option>
            {vehicleMakes.map((make) => <option value={make.name}>{make.name}</option>)}
            <option value="__other">{vehicle.otherMake}</option>
          </select>
        </div>
        <div class="funnel-field-full" data-vehicle-custom hidden>
          <Label for={fieldId('other-make')}>{vehicle.customMake} *</Label>
          <Input id={fieldId('other-make')} name="otherMake" maxlength="60" disabled />
        </div>
        <div class="funnel-field-full">
          <Label for={fieldId('model')}>{copy.labels.vehicleModel} *</Label>
          <select id={fieldId('model')} name="vehicleModel" class="ui-form-input" required disabled aria-describedby={fieldId('vehicle-status')}>
            <option value="">{vehicle.chooseFirst}</option>
          </select>
        </div>
        <div class="funnel-field-full" data-vehicle-custom hidden>
          <Label for={fieldId('other-model')}>{vehicle.customModel} *</Label>
          <Input id={fieldId('other-model')} name="otherModel" maxlength="80" disabled />
        </div>
      </div>
      <Text id={fieldId('vehicle-status')} data-vehicle-status role="status" aria-live="polite" tabindex="-1" variant="feature-body-sm" class="mt-3 empty:hidden text-brand-dark/65" />
      <Text variant="disclaimer" class="mt-4 text-brand-dark/65">{copy.required}</Text>
    </section>

    <section data-funnel-step="2" hidden aria-labelledby={fieldId('key-title')}>
      <Heading id={fieldId('key-title')} tag="h2" class="funnel-title" tabindex="-1">{flow.keyTitle}</Heading>
      <Text class="funnel-description">{flow.keyDescription}</Text>
      <fieldset class="funnel-key-options">
        <legend class="sr-only">{copy.labels.workingKey} *</legend>
        {copy.workingKeys.map((option) => <label><input type="radio" name="workingKey" value={option.value} required /><span>{option.label}</span></label>)}
      </fieldset>
      <Text data-no-key hidden variant="feature-body-sm" class="my-4 rounded-xl bg-brand-accent/15 p-4">{flow.noKey} <a href={phoneHref} class="underline underline-offset-2">{company.phone}</a></Text>
      <div class="mt-5">
        <Label for={fieldId('service')}>{copy.labels.service} *</Label>
        <select id={fieldId('service')} name="service" class="ui-form-input" required>
          <option value="">{copy.placeholders.select}</option>
          {copy.services.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
      </div>
    </section>

    <section data-funnel-step="3" hidden aria-labelledby={fieldId('contact-title')}>
      <Heading id={fieldId('contact-title')} tag="h2" class="funnel-title" tabindex="-1">{flow.contactTitle}</Heading>
      <Text class="funnel-description">{flow.contactDescription}</Text>
      <div class="funnel-fields">
        <div>
          <Label for={fieldId('name')}>{copy.labels.name} *</Label>
          <Input id={fieldId('name')} name="name" autocomplete="name" placeholder={copy.placeholders.name} required maxlength="80" />
        </div>
        <div>
          <Label for={fieldId('phone')}>{copy.labels.phone} *</Label>
          <Input id={fieldId('phone')} name="phone" type="tel" autocomplete="tel" placeholder={copy.placeholders.phone} required maxlength="25" />
        </div>
        <div class="funnel-field-full">
          <Label for={fieldId('location')}>{copy.labels.location} *</Label>
          <Input id={fieldId('location')} name="location" autocomplete="address-level2" placeholder={copy.placeholders.location} required maxlength="100" />
        </div>
        <div>
          <Label for={fieldId('date')}>{copy.labels.preferredDate}</Label>
          <Input id={fieldId('date')} name="preferredDate" type="date" min={getAppointmentToday()} />
        </div>
        <div>
          <Label for={fieldId('time')}>{copy.labels.preferredTime}</Label>
          <select id={fieldId('time')} name="preferredTime" class="ui-form-input">
            <option value="">{copy.placeholders.select}</option>
            {copy.times.map((option) => <option value={option.value}>{option.label}</option>)}
          </select>
        </div>
        <div class="funnel-field-full">
          <Label for={fieldId('notes')}>{copy.labels.notes}</Label>
          <Textarea id={fieldId('notes')} name="notes" rows={2} maxlength="500" placeholder={copy.placeholders.notes} />
        </div>
      </div>
      <Text variant="disclaimer" class="mt-4 text-brand-dark/65">{copy.required}</Text>
    </section>

    <section data-funnel-step="4" hidden aria-labelledby={fieldId('review-title')}>
      <Heading id={fieldId('review-title')} tag="h2" class="funnel-title" tabindex="-1">{flow.reviewTitle}</Heading>
      <Text class="funnel-description">{flow.reviewDescription}</Text>
      <Label for={fieldId('preview')}>{copy.preview}</Label>
      <Textarea id={fieldId('preview')} data-funnel-preview readonly rows={10} class="text-sm" />
      <Text variant="feature-body-sm" class="my-5">{withPhone(copy.handoff)}</Text>
      <div class="funnel-actions">
        <Button type="submit" variant="primary">{copy.submit}</Button>
        <Button type="button" variant="outline" data-funnel-copy>{copy.copy}</Button>
      </div>
      <Text variant="disclaimer" class="mt-4 text-brand-dark/65">{withPhone(copy.fallback)}</Text>
    </section>

    <div data-funnel-navigation hidden class="funnel-navigation">
      <Button type="button" variant="outline" data-funnel-back>← {flow.back}</Button>
      <Button type="button" variant="primary" data-funnel-next><span data-funnel-next-label>{flow.next}</span> →</Button>
    </div>
    <Text data-funnel-status role="status" aria-live="polite" class="mt-4 empty:hidden" />
    <div data-funnel-privacy hidden>
      <Text variant="disclaimer" class="mt-5 text-brand-dark/65">{copy.privacy}{' '}<a href={getNovaNavigationPath('/privacy-policy/', locale)} class="underline underline-offset-2">{copy.privacyLink}</a></Text>
    </div>
  </form>
  <noscript><p class="mt-5">{flow.help} <a href={phoneHref}>{flow.call}: {company.phone}</a> · <a href={smsHref}>{flow.text}</a></p></noscript>
</div>

<style>
  .key-funnel { min-width: 0; container-type: inline-size; scroll-margin-top: var(--funnel-scroll-offset, 1rem); }
  .key-funnel [hidden] { display: none !important; }
  .key-funnel :global(.funnel-title) { margin: 0; font-size: clamp(1.65rem, 3vw, 2.3rem); line-height: 1.12; letter-spacing: -0.045em; outline: none; scroll-margin-top: calc(var(--site-header-height, 5.75rem) + 1rem); }
  .key-funnel :global(.funnel-description) { margin-top: 0.75rem; margin-bottom: 1.5rem; color: var(--ui-text-on-light-subtle); font-size: 1rem; line-height: 1.55; }
  .key-funnel :global(.ui-type-disclaimer) { color: var(--color-on-surface-variant); opacity: 1; font-style: normal; font-size: 0.78rem; line-height: 1.55; }
  .funnel-choices { display: grid; gap: 1rem; }
  .funnel-choice { display: flex; width: 100%; align-items: center; gap: 1rem; padding: 1.25rem; border: 1px solid var(--color-outline-variant); border-radius: var(--ui-radius-md); text-align: left; cursor: pointer; background: var(--color-surface); color: var(--color-brand-dark); transition: transform 180ms, border-color 180ms, background 180ms; }
  .funnel-choice:hover { transform: translateY(-2px); border-color: var(--color-brand-accent); background: var(--color-brand-cream); }
  .funnel-choice:focus-visible, .funnel-text-button:focus-visible { outline: 3px solid var(--color-brand-accent); outline-offset: 3px; }
  .funnel-choice-urgent { background: color-mix(in oklab, var(--color-brand-accent) 13%, var(--color-surface)); border-color: var(--color-brand-accent); }
  .funnel-choice strong { display: block; font-size: 1.05rem; line-height: 1.4; }
  .funnel-choice-detail { display: block; margin-top: 0.35rem; font-size: 0.9rem; line-height: 1.5; color: var(--ui-text-on-light-subtle); }
  .funnel-choice-icon { display: grid; flex-shrink: 0; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--color-brand-dark); color: var(--color-brand-light); }
  .funnel-choice-arrow { margin-left: auto; font-size: 1.5rem; }
  .funnel-phone { display: block; width: fit-content; margin-block: 1.75rem; font-size: clamp(1.8rem, 5vw, 2.6rem); font-weight: 700; letter-spacing: -0.04em; text-decoration: underline; text-underline-offset: 0.3rem; }
  .funnel-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .funnel-text-button { display: block; min-height: 2.75rem; text-align: left; text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer; }
  .funnel-progress { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.5rem; padding: 0; margin: 0 0 1.75rem; list-style: none; }
  .funnel-progress li { border-top: 3px solid var(--color-outline-variant); padding-top: 0.5rem; color: var(--ui-text-on-light-subtle); font-size: 0.7rem; overflow-wrap: anywhere; }
  .funnel-progress li span { display: block; font-weight: 700; }
  .funnel-progress li[aria-current="step"] { border-color: var(--color-brand-dark); color: var(--color-brand-dark); font-weight: 700; }
  .funnel-progress li[data-complete] { border-color: var(--color-brand-accent); }
  .funnel-fields { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  .funnel-fields > div { min-width: 0; }
  .funnel-field-full { grid-column: 1 / -1; }
  .key-funnel :global(input), .key-funnel :global(select), .key-funnel :global(textarea) { min-width: 0; max-width: 100%; font-size: 1rem; scroll-margin-top: var(--funnel-scroll-offset, 1rem); }
  .funnel-key-options { display: flex; flex-wrap: wrap; gap: 0.75rem; border: 0; padding: 0; margin: 0; }
  .funnel-key-options label { position: relative; display: flex; align-items: center; gap: 0.5rem; min-height: 3rem; padding: 0.65rem 1rem; border: 1px solid var(--color-outline-variant); border-radius: var(--ui-radius-base); cursor: pointer; }
  .funnel-key-options label:has(:checked) { border-color: var(--color-brand-dark); background: var(--color-brand-cream); }
  .funnel-key-options input { width: 1rem; height: 1rem; accent-color: var(--color-brand-dark); }
  .funnel-navigation { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem; padding-top: 1.5rem; margin-top: 1.5rem; border-top: 1px solid var(--color-outline-variant); }
  @container (min-width: 26rem) { .funnel-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 380px) { .funnel-choice { padding: 1rem; gap: 0.65rem; } .funnel-choice-icon { display: none; } .funnel-actions { flex-direction: column; } }
  @media (prefers-reduced-motion: reduce) { .funnel-choice { transition: none; } .funnel-choice:hover { transform: none; } }
</style>

<script>
  import { initKeyRequestFunnels } from '@utils/key-request-funnel';
  document.addEventListener('astro:page-load', initKeyRequestFunnels);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initKeyRequestFunnels);
  else initKeyRequestFunnels();
</script>
