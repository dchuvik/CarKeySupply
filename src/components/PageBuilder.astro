---
import Hero from '@components/registry/hero/NovaHeroResponsiveBlock.astro';
import Projects from '@components/registry/portfolio/ProjectsBlock.astro';
import Services from '@components/registry/services/ServicesHomeBlock.astro';
import About from '@components/registry/about/TeamBlock.astro';
import Steps from '@components/registry/process/StepsNumberedBlock.astro';
import ServiceArea from '@components/registry/services/FeatureGridBlock.astro';
import Faq from '@components/registry/faq/Faq3Block.astro';
import { getNovaCopy, type NovaLocale } from '@utils/nova-i18n';

interface Props { locale?: NovaLocale; }
const { locale = 'en' } = Astro.props;
const copy = getNovaCopy(locale).sections;
---

<Hero {...copy['nova-hero-wireframe']} locale={locale} />
<Services {...copy['nova-services']} locale={locale} />
<Projects {...copy['nova-projects']} />
<Steps {...copy['steps-numbered']} />
<About {...copy['nova-team']} locale={locale} />
<ServiceArea {...copy['feature-grid']} />
<Faq {...copy.faq3} />
