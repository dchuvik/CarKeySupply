---
import Section from '@components/ui/layout/Section.astro';
import Container from '@components/ui/layout/Container.astro';
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import SmartImage from '@components/ui/atoms/SmartImage.astro';
import KeyRequestFunnel from '@components/ui/molecules/KeyRequestFunnel.astro';
import company from '@data/global/company.json';
import appointments from '@data/global/appointments.json';
import type { NovaLocale } from '@utils/nova-i18n';

interface Props {
  eyebrow?: string;
  heading?: string;
  headingAccent?: string;
  description?: string;
  stats?: { value: string; label: string }[];
  sectionId?: string;
  locale?: NovaLocale;
  class?: string;
}
const { locale = 'en', ...props } = Astro.props;
const flow = appointments[locale].funnel;
const shopAlt = 'Car Key Supply shop at 598 State Route 5 in Elbridge';
---

<Section id={props.sectionId ?? 'hero'} tone="page" class:list={['hero-section funnel-hero pt-[calc(var(--site-header-height,5.75rem)+var(--hero-below-header-gap,0.75rem))] pb-0', props.class]}>
  <Container class="w-full max-w-none px-0">
    <div class="funnel-hero-shell">
      <div class="funnel-hero-grid">
        <div class="funnel-hero-intro">
          <Text tag="p" variant="accent-label" class="mb-5 font-semibold tracking-[0.14em] text-brand-dark/65">{props.eyebrow}</Text>
          <Heading tag="h1" variant="hero" class="max-w-xl text-[clamp(2.75rem,6vw,4.5rem)] leading-[0.98] tracking-[-0.065em]">{props.heading}<br /><span class="text-brand-accent">{props.headingAccent}</span></Heading>
          <Text variant="lead" class="mt-5 max-w-lg text-[clamp(1rem,1.5vw,1.15rem)]">{props.description}</Text>
          <figure class="funnel-shop">
            <SmartImage src="/assets/images/shop.webp" alt={shopAlt} width={128} height={101} loading="eager" sizes="128px" class="funnel-shop-photo" />
            <figcaption>
              <Text tag="strong" variant="feature-body-sm" class="block font-bold">{flow.shop} · {flow.appointmentOnly}</Text>
              <Text tag="span" variant="feature-body-sm" class="block">{company.address}</Text>
              <Text tag="span" variant="feature-body-sm" class="block">{`${company.city}, ${company.state} ${company.zipCode}`}</Text>
            </figcaption>
          </figure>
        </div>
        <div class="funnel-hero-card">
          <KeyRequestFunnel locale={locale} id="home-request" />
        </div>
      </div>
      <div class="funnel-hero-stats">
        {(props.stats ?? []).map((stat) => <div><strong>{stat.value}</strong><Text tag="span" variant="feature-body-sm" class="text-brand-light/80">{stat.label}</Text></div>)}
      </div>
    </div>
  </Container>
</Section>

<style>
  .funnel-hero-shell { overflow: hidden; border-radius: var(--ui-radius-xl) var(--ui-radius-xl) 0 0; background: var(--color-brand-cream); }
  .funnel-hero-grid { display: grid; align-items: start; max-width: 90rem; margin-inline: auto; gap: clamp(1.75rem, 4vw, 4rem); padding: clamp(1.25rem, 4vw, 4rem); }
  .funnel-hero-intro { min-width: 0; }
  .funnel-hero-card { min-width: 0; padding: clamp(1.25rem, 3vw, 2.25rem); background: var(--color-surface); border: 1px solid var(--color-outline-variant); border-radius: var(--ui-radius-lg); box-shadow: var(--ui-elevation-soft); }
  .funnel-shop { display: none; align-items: center; gap: 1rem; margin-top: 1.75rem; padding: 0.85rem; border: 1px solid var(--color-outline-variant); border-radius: var(--ui-radius-md); background: var(--color-surface); }
  .funnel-shop :global(picture) { flex-shrink: 0; }
  .funnel-shop :global(.funnel-shop-photo) { display: block; width: 7rem; height: 6rem; object-fit: cover; object-position: center; border-radius: var(--ui-radius-sm); }
  .funnel-shop figcaption { min-width: 0; line-height: 1.6; }
  .funnel-hero-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; padding: 1.75rem clamp(1.25rem, 4vw, 4rem); background: var(--color-brand-dark); color: var(--color-brand-light); }
  .funnel-hero-stats > div { display: flex; flex-direction: column; gap: 0.35rem; }
  .funnel-hero-stats strong { font-size: 1.25rem; color: var(--color-brand-accent); }
  @media (min-width: 768px) { .funnel-hero-grid { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); } .funnel-shop { display: flex; } .funnel-hero-stats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
